<?xml version="1.0" encoding="utf-8"?>
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">

    <!-- 设置圆角为高度的一半，实现椭圆形效果 -->
    <corners android:radius="50dp" />

    <!-- 设置渐变颜色 -->
    <gradient
    android:angle="270"
    android:startColor="@color/color_ac00ff"
    android:endColor="@color/color_ff6d9f"
    android:type="linear" />

    <!-- 设置按钮内边距 -->
    <padding
        android:bottom="12dp"
        android:left="24dp"
        android:right="24dp"
        android:top="12dp" />
</shape>