<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    xmlns:tools="http://schemas.android.com/tools"
    android:paddingTop="14dp"
    android:paddingBottom="14dp">

    <ImageView
        android:id="@+id/ivIcon"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:src="@mipmap/icon_heard_cricle"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        />

    <TextView
        android:id="@+id/tvName"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxWidth="100dp"
        tools:text="ss"
        android:maxLines="1"
        android:ellipsize="end"
        android:textColor="@color/white"
        android:textSize="14sp"
        android:singleLine="true"
        app:layout_constraintTop_toTopOf="@+id/ivIcon"
        app:layout_constraintStart_toEndOf="@+id/ivIcon"
        android:layout_marginStart="10dp"
        />

    <TextView
        android:id="@+id/tvState"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="已公开"
        android:textColor="@color/primary_color"
        android:textSize="10sp"
        android:background="@drawable/bg_stroke_primary_r50"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        android:paddingTop="2dp"
        android:paddingBottom="2dp"
        android:layout_marginStart="10dp"
        android:gravity="center"
        app:layout_constraintStart_toEndOf="@+id/tvName"
        app:layout_constraintTop_toTopOf="@+id/tvName"
        app:layout_constraintBottom_toBottomOf="@+id/tvName" />

    <ImageView
        android:id="@+id/ivPermanentMemory"
        android:layout_width="20dp"
        android:layout_height="15dp"
        app:layout_constraintStart_toEndOf="@+id/tvState"
        app:layout_constraintTop_toTopOf="@+id/tvState"
        android:src="@mipmap/icon_shop_item_card"
        />

    <TextView
        android:id="@+id/tvChatMessage"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        tools:text="嘴角扬起一抹张扬的笑，揭开赛车服全部赛车服全部赛车服全部赛车服全部扣子"
        android:textColor="@color/color_8a8a8a"
        android:textSize="12sp"
        app:layout_constraintStart_toEndOf="@+id/ivIcon"
        app:layout_constraintBottom_toBottomOf="@+id/ivIcon"
        app:layout_constraintEnd_toEndOf="parent"
        android:ellipsize="end"
        android:maxLines="1"
        android:layout_marginTop="5dp"
        android:layout_marginStart="10dp"
        />

    <ImageView
        android:id="@+id/ivIsPinned"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@mipmap/icon_ispinned"
        app:layout_constraintEnd_toStartOf="@+id/tvTime"
        app:layout_constraintTop_toTopOf="@+id/tvTime"
        android:layout_marginEnd="10dp"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="@+id/tvTime"
        />
    <TextView
        android:id="@+id/tvTime"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        tools:text="刚刚"
        android:textColor="@color/color_8a8a8a"
        android:textSize="12sp"
        app:layout_constraintEnd_toStartOf="@+id/ivMore"
        android:layout_marginEnd="10dp"
        app:layout_constraintTop_toTopOf="@+id/ivIcon"
        android:layout_marginBottom="5dp"
        android:layout_marginTop="5dp"
        android:layout_marginStart="5dp"
        />
    <ImageView
        android:id="@+id/ivMore"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@mipmap/icon_shenlv"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/tvTime"
        android:layout_marginEnd="10dp"
        app:layout_constraintBottom_toBottomOf="@+id/tvTime"
        />

</androidx.constraintlayout.widget.ConstraintLayout>