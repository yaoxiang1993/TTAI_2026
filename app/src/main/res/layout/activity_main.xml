<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/color_1c1d20"
    android:orientation="vertical">
    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/view_pager"
        android:layout_width="match_parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintBottom_toTopOf="@+id/bottom_navigation"
        android:layout_height="0dp"
        android:layout_weight="1"/>

    <LinearLayout
        android:id="@+id/bottom_navigation"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="@color/color_1c1d20"
        android:paddingTop="8dp"
        android:paddingBottom="8dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- 消息 -->
        <LinearLayout
            android:id="@+id/nav_home"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="8dp"
            android:clickable="true"
            android:focusable="true"
            android:background="?android:attr/selectableItemBackground">

            <ImageView
                android:id="@+id/nav_home_icon"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@mipmap/icon_tab_message"
                app:tint="@color/color_ffffff" />

            <TextView
                android:id="@+id/nav_home_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="消息"
                android:textSize="12sp"
                android:textColor="@color/color_ffffff"
                android:layout_marginTop="4dp" />
        </LinearLayout>

        <!-- 梦境 -->
        <LinearLayout
            android:id="@+id/nav_dream"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="8dp"
            android:clickable="true"
            android:focusable="true"
            android:background="?android:attr/selectableItemBackground">

            <ImageView
                android:id="@+id/nav_dream_icon"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@mipmap/icon_tab_dream"
                android:tint="@color/color_6b6b6b"
                tools:ignore="UseAppTint" />

            <TextView
                android:id="@+id/nav_dream_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="梦境"
                android:textSize="12sp"
                android:textColor="@color/color_6b6b6b"
                android:layout_marginTop="4dp" />
        </LinearLayout>

        <!-- 创建AI（只显示图标） -->
        <LinearLayout
            android:id="@+id/nav_create_ai"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="8dp"
            android:clickable="true"
            android:focusable="true" >

            <ImageView
                android:id="@+id/nav_create_ai_icon"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:src="@mipmap/icon_create_ai"  />
        </LinearLayout>

        <!-- 控制 -->
        <LinearLayout
            android:id="@+id/nav_control"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="8dp"
            android:clickable="true"
            android:focusable="true"
            android:background="?android:attr/selectableItemBackground">

            <ImageView
                android:id="@+id/nav_control_icon"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@mipmap/icon_tab_control"
                app:tint="@color/color_6b6b6b" />

            <TextView
                android:id="@+id/nav_control_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="控制"
                android:textSize="12sp"
                android:textColor="@color/color_6b6b6b"
                android:layout_marginTop="4dp" />
        </LinearLayout>

        <!-- 我的 -->
        <LinearLayout
            android:id="@+id/nav_my"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="8dp"
            android:clickable="true"
            android:focusable="true"
            android:background="?android:attr/selectableItemBackground">

            <ImageView
                android:id="@+id/nav_my_icon"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@mipmap/icon_tab_my"
                app:tint="@color/color_6b6b6b" />

            <TextView
                android:id="@+id/nav_my_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="我的"
                android:textSize="12sp"
                android:textColor="@color/color_6b6b6b"
                android:layout_marginTop="4dp" />
        </LinearLayout>

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>