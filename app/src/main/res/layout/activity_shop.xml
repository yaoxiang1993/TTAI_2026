<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/color_1c1d20"
    android:paddingTop="10dp"
    android:fitsSystemWindows="true"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <ImageView
        android:id="@+id/ivBack"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@mipmap/icon_arrow_left_white"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        android:padding="10dp"
        />
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="@+id/ivBack"
        app:layout_constraintBottom_toBottomOf="@+id/ivBack"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:text="商店"
        android:textSize="18sp"
        android:textColor="@color/white"
        />

    <TextView
        android:id="@+id/tvShopToy"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="玩具"
        android:textSize="14sp"
        app:layout_constraintTop_toBottomOf="@+id/ivBack"
        app:layout_constraintStart_toStartOf="parent"
        android:textColor="@color/color_ffffff"
        android:layout_marginTop="10dp"
        android:padding="4dp"
        android:layout_marginStart="10dp"
        />
    <TextView
        android:id="@+id/tvShopItems"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="道具"
        android:textSize="14sp"
        app:layout_constraintTop_toBottomOf="@+id/ivBack"
        app:layout_constraintStart_toEndOf="@+id/tvShopToy"
        android:textColor="@color/color_ffffff"
        android:layout_marginTop="10dp"
        android:padding="4dp"
        android:layout_marginStart="10dp"
        />
    <TextView
        android:id="@+id/tvShopBeautify"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="美化"
        android:textSize="14sp"
        app:layout_constraintTop_toBottomOf="@+id/ivBack"
        app:layout_constraintStart_toEndOf="@+id/tvShopItems"
        android:textColor="@color/color_ffffff"
        android:layout_marginTop="10dp"
        android:padding="4dp"
        android:layout_marginStart="10dp"
        />
    <TextView
        android:id="@+id/tvShopWorldBook"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="世界书"
        android:textSize="14sp"
        app:layout_constraintTop_toBottomOf="@+id/ivBack"
        app:layout_constraintStart_toEndOf="@+id/tvShopBeautify"
        android:textColor="@color/color_ffffff"
        android:layout_marginTop="10dp"
        android:padding="4dp"
        android:layout_marginStart="10dp"
        />
    <TextView
        android:id="@+id/tvShopOwned"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="已拥有"
        android:textSize="14sp"
        app:layout_constraintTop_toBottomOf="@+id/ivBack"
        app:layout_constraintStart_toEndOf="@+id/tvShopWorldBook"
        android:textColor="@color/color_ffffff"
        android:layout_marginTop="10dp"
        android:padding="4dp"
        android:layout_marginStart="10dp"
        />
    <!-- 内容区域：使用 ViewPager2 实现切换 -->
    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/viewPager"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:background="@color/color_1c1d20"
        app:tabBackground="@color/color_1c1d20"
        app:layout_constraintTop_toBottomOf="@+id/tvShopItems"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>