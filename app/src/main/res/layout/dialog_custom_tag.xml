<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_1c1d21_r20"
    android:padding="24dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="添加自定义标签"
        android:textColor="@color/white"
        android:textSize="18sp"
        android:textStyle="bold"
        android:layout_marginBottom="16dp" />

    <EditText
        android:id="@+id/edtCustomTag"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="请输入标签内容"
        android:textColorHint="@color/color_6b6b6b"
        android:textColor="@color/white"
        android:textSize="16sp"
        android:background="@drawable/bg_383838_r5"
        android:padding="16dp"
        android:maxLength="10"
        android:inputType="text"
        android:imeOptions="actionDone"
        android:layout_marginBottom="24dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="end">

        <TextView
            android:id="@+id/tvCancel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="取消"
            android:textColor="@color/color_6b6b6b"
            android:textSize="16sp"
            android:padding="12dp"
            android:layout_marginEnd="16dp" />

        <TextView
            android:id="@+id/tvConfirm"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="确定"
            android:textColor="@color/primary_color"
            android:textSize="16sp"
            android:textStyle="bold"
            android:padding="12dp" />

    </LinearLayout>

</LinearLayout> 