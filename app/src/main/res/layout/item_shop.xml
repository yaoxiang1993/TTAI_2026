<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:paddingStart="5dp"
    android:paddingEnd="5dp"
    android:paddingTop="5dp"
    android:clickable="true"
    android:focusable="true">


    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/clyCard"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:paddingTop="12dp"
        android:paddingBottom="12dp"
        android:paddingStart="6dp"
        android:paddingEnd="6dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        android:background="@drawable/bg_383838_r10"
        >
        <ImageView
            android:id="@+id/ivHeard"
            android:layout_width="92dp"
            android:layout_height="76dp"
            android:src="@mipmap/icon_shop_item_card"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            />
    </androidx.constraintlayout.widget.ConstraintLayout>

    <TextView
        android:id="@+id/tvShopName"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textSize="14sp"
        android:textColor="@color/color_ffffff"
        android:layout_marginTop="5dp"
        tools:text = "记忆之芯"
        android:drawableEnd="@mipmap/icon_question_mark"
        android:drawablePadding="3dp"
        app:layout_constraintStart_toStartOf="@+id/clyCard"
        app:layout_constraintEnd_toEndOf="@+id/clyCard"
        app:layout_constraintTop_toBottomOf="@+id/clyCard"
        />

    <TextView
        android:id="@+id/tvPrice"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textSize="14sp"
        android:textColor="@color/color_ffffff"
        android:layout_marginTop="5dp"
        tools:text = "6000"
        app:layout_constraintStart_toStartOf="@+id/clyCard"
        app:layout_constraintEnd_toEndOf="@+id/clyCard"
        app:layout_constraintTop_toBottomOf="@+id/tvShopName"
        android:drawableStart="@mipmap/icon_unit_1_big"
        />


</androidx.constraintlayout.widget.ConstraintLayout>