<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    xmlns:tools="http://schemas.android.com/tools"
    android:background="@color/color_1c1d20"
    android:padding="16dp">

    <ImageView
        android:id="@+id/ivIcon"
        android:layout_width="50dp"
        android:layout_height="50dp"
        android:src="@mipmap/icon_item_model_"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        />

    <TextView
        android:id="@+id/tvName"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="输入远程码"
        android:textColor="@color/white"
        android:textSize="14sp"
        app:layout_constraintTop_toTopOf="@+id/ivIcon"
        app:layout_constraintStart_toEndOf="@+id/ivIcon"
        app:layout_constraintBottom_toBottomOf="@+id/ivIcon"
        android:layout_marginStart="10dp"
        />

    <ImageView
        android:id="@+id/ivGifPlay"
        android:layout_width="160dp"
        android:layout_height="60dp"
        android:scaleType="fitCenter"
        android:src="@mipmap/gif_play_1"
        app:layout_constraintTop_toTopOf="@+id/ivIcon"
        app:layout_constraintEnd_toStartOf="@+id/ivCollected"
        app:layout_constraintBottom_toBottomOf="@+id/ivIcon"
        android:visibility="gone"
        tools:visibility="visible"
        />
    <ImageView
        android:id="@+id/ivPlay"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@mipmap/icon_play"
        app:layout_constraintTop_toTopOf="@+id/ivIcon"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="@+id/ivIcon"
        android:layout_marginEnd="60dp"
        />
    <ImageView
        android:id="@+id/ivCollected"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@mipmap/icon_have_collected"
        app:layout_constraintTop_toTopOf="@+id/ivIcon"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="@+id/ivIcon"
        android:layout_marginEnd="20dp"
        />


</androidx.constraintlayout.widget.ConstraintLayout>