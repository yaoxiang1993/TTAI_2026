<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:fitsSystemWindows="true"
    android:layout_height="match_parent"
    android:background="@color/color_1c1d20">

    <ImageView
        android:id="@+id/ivBack"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:padding="10dp"
        android:src="@mipmap/icon_arrow_left_white"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />


    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/clyName"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:layout_marginTop="50dp"
        android:layout_marginEnd="10dp"
        android:padding="15dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:id="@+id/ivHeard"
            android:layout_width="66dp"
            android:layout_height="66dp"
            android:src="@mipmap/icon_heard"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/tvName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:textColor="@color/white"
            android:textSize="20sp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toEndOf="@+id/ivHeard"
            app:layout_constraintTop_toTopOf="parent"
            tools:text="XXXX" />


        <TextView
            android:id="@+id/tvId"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="12sp"
            android:textColor="@color/color_6b6b6b"
            app:layout_constraintStart_toStartOf="@+id/tvName"
            app:layout_constraintTop_toBottomOf="@+id/tvName"
            android:drawablePadding="8dp"
            tools:text="ID:1012"
            android:gravity="center_vertical"
            />
    </androidx.constraintlayout.widget.ConstraintLayout>


    <TextView
        android:id="@+id/tvBriefingNote"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:layout_marginEnd="10dp"
        android:textColor="@color/white"
        android:textSize="12sp"
        android:layout_marginTop="6dp"
        app:layout_constraintStart_toStartOf="@+id/clyName"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/clyName"
        tools:text="简介" />
    <TextView
        android:id="@+id/tvFans"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="@color/white"
        android:textSize="13sp"
        android:layout_marginTop="10dp"
        app:layout_constraintStart_toStartOf="@+id/tvBriefingNote"
        app:layout_constraintTop_toBottomOf="@+id/tvBriefingNote"
        tools:text="2W" />


    <TextView
        android:id="@+id/tvFansText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="@color/white"
        android:textSize="13sp"
        android:layout_marginTop="5dp"
        app:layout_constraintStart_toStartOf="@+id/tvFans"
        app:layout_constraintTop_toBottomOf="@+id/tvFans"
        android:text="粉丝" />

    <View
        android:id="@+id/view"
        android:layout_width="1dp"
        android:layout_height="40dp"
        android:background="@color/color_686868"
        app:layout_constraintStart_toEndOf="@+id/tvFansText"
        app:layout_constraintTop_toTopOf="@+id/tvFans"
        app:layout_constraintBottom_toBottomOf="@+id/tvFansText"
        android:layout_marginStart="30dp"
        />

    <TextView
        android:id="@+id/tvFocusNumber"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="@color/white"
        android:textSize="13sp"
        app:layout_constraintStart_toEndOf="@+id/view"
        app:layout_constraintTop_toTopOf="@+id/tvFans"
        android:layout_marginStart="30dp"
        tools:text="2W" />


    <TextView
        android:id="@+id/tvFocusText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="@color/white"
        android:textSize="13sp"
        android:layout_marginTop="5dp"
        app:layout_constraintStart_toStartOf="@+id/tvFocusNumber"
        app:layout_constraintTop_toBottomOf="@+id/tvFocusNumber"
        android:text="关注" />

    <TextView
        android:id="@+id/tvFollow"
        android:layout_width="95dp"
        android:layout_height="34dp"
        android:layout_marginStart="40dp"
        android:layout_marginEnd="20dp"
        android:layout_marginBottom="20dp"
        android:background="@drawable/bg_gradient_b2a4f9_e5b1fb"
        android:gravity="center"
        android:radius="100dp"
        android:text="关注"
        android:textColor="#FFFFFFFF"
        android:textSize="14sp"
        app:layout_constraintStart_toEndOf="@+id/tvFocusNumber"
        app:layout_constraintTop_toTopOf="@+id/tvFocusNumber"
        />


    <TextView
        android:id="@+id/tvRole"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="@color/white"
        android:textSize="14sp"
        app:layout_constraintStart_toStartOf="@+id/tvFansText"
        app:layout_constraintTop_toBottomOf="@+id/tvFansText"
        android:layout_marginTop="15dp"
        tools:text="角色" />

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/clySearch"
        android:layout_width="0dp"
        android:layout_height="35dp"
        android:background="@drawable/bg_292a2e_r10"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        android:layout_marginTop="15dp"
        app:layout_constraintTop_toBottomOf="@+id/tvRole"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        >
        <EditText
            android:id="@+id/edtSearch"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginStart="10dp"
            android:textColorHint="@color/color_6f6e70"
            android:textSize="15sp"
            android:textColor="@color/white"
            android:drawableStart="@mipmap/icon_search"
            android:background="@android:color/transparent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            android:layout_marginEnd="10dp"
            app:layout_constraintTop_toTopOf="parent"  />
    </androidx.constraintlayout.widget.ConstraintLayout>
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/mRecyclerView"
            app:layout_constraintTop_toBottomOf="@+id/clySearch"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:overScrollMode="never"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:scrollbars="vertical" />

</androidx.constraintlayout.widget.ConstraintLayout>