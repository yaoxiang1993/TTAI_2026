<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:fitsSystemWindows="true"
    android:layout_height="match_parent"
    android:id="@+id/clyGroup"
    >

    <!-- 背景图片 -->


    <!-- 顶部工具栏 -->
    <ImageView
        android:id="@+id/iv_background"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:src="@mipmap/icon_defult_loading_big"
        tools:layout_editor_absoluteX="0dp"
        tools:layout_editor_absoluteY="0dp" />

    <RelativeLayout
        android:id="@+id/rlyTitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="15dp"
        android:paddingTop="24dp"
        android:paddingBottom="8dp">
            <TextView
                android:id="@+id/tvName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                tools:text="化世豪"
                android:layout_marginStart="10dp"
                android:textSize="14sp"
                android:textColor="@color/white" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:layout_marginEnd="10dp"
            android:orientation="horizontal"
            android:background="@drawable/bg_b3383838_r50"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingTop="5dp"
            android:paddingBottom="5dp">
            <ImageView
                android:id="@+id/ivMenu"
                android:layout_width="25dp"
                android:layout_height="25dp"
                android:layout_marginStart="10dp"
                android:src="@mipmap/icon_menu" />
        </LinearLayout>
    </RelativeLayout>

    <TextView
        android:id="@+id/tvVideoTip"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        tools:text="与角色通话将消耗 1 仙玉/秒"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        android:layout_marginTop="40dp"
        android:textSize="12sp"
        android:textColor="@color/white" />

    <ImageView
        android:id="@+id/ivHeard"
        android:layout_width="100dp"
        android:layout_height="100dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        android:layout_marginTop="120dp"
        android:src="@mipmap/icon_heard_cricle" />

    <TextView
        android:id="@+id/tvName1"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        tools:text="化世豪"
        android:layout_marginTop="20dp"
        app:layout_constraintTop_toBottomOf="@+id/ivHeard"
        app:layout_constraintStart_toStartOf="@+id/ivHeard"
        app:layout_constraintEnd_toEndOf="@+id/ivHeard"
        android:textSize="24sp"
        android:textColor="@color/white" />
    <TextView
        android:id="@+id/tvConnectTip"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="邀请你视频通话"
        android:layout_marginTop="20dp"
        app:layout_constraintTop_toBottomOf="@+id/tvName1"
        app:layout_constraintStart_toStartOf="@+id/ivHeard"
        app:layout_constraintEnd_toEndOf="@+id/ivHeard"
        android:textSize="14sp"
        android:textColor="@color/color_b4b4b4" />


    <ImageView
        android:id="@+id/ivPhoneConnect"
        android:layout_width="70dp"
        android:layout_height="70dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginBottom="130dp"
        android:layout_marginEnd="70dp"
        android:src="@mipmap/icon_phone_connected" />
    <ImageView
        android:id="@+id/ivPhoneHangUp"
        android:layout_width="70dp"
        android:layout_height="70dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_marginBottom="130dp"
        android:layout_marginStart="70dp"
        android:src="@mipmap/icon_phone_hang_up" />

    <LinearLayout
        android:id="@+id/input_container"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="8dp"
        android:paddingBottom="8dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:background="@android:color/transparent">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_b3383838_r10"
            >
        <EditText
            android:id="@+id/et_message"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:minHeight="45dp"
            android:maxHeight="120dp"
            android:focusable="true"
            android:maxLength="1500"
            android:focusableInTouchMode="true"
            android:gravity="top|start"
            android:hint="发送信息给他/她吧~~"
            android:background="@android:color/transparent"
            android:imeOptions="actionSend"
            android:inputType="textCapSentences|textMultiLine"
            android:maxLines="5"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingTop="12dp"
            android:paddingBottom="12dp"
            android:scrollbars="vertical"
            android:textColor="@color/white"
            android:textColorHint="@color/color_b6b6b6"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/tvSendMessage"
            android:textSize="14sp" />
        <TextView
            android:id="@+id/tvSendMessage"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/primary_color"
            android:textSize="14sp"
            android:padding="4dp"
            android:layout_marginStart="10dp"
            android:layout_marginEnd="10dp"
            android:layout_marginBottom="10dp"
            android:text="发送"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            />
        </androidx.constraintlayout.widget.ConstraintLayout>
    </LinearLayout>


</androidx.constraintlayout.widget.ConstraintLayout>