<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/color_1c1d20"
    android:paddingTop="10dp"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <TextView
        android:id="@+id/tvSynthesize"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="综合"
        android:textSize="20sp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        android:textColor="@color/color_ffffff"
        android:layout_marginTop="10dp"
        android:layout_marginStart="20dp"
        />
    <TextView
        android:id="@+id/tvFeatured"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="精选"
        android:textSize="20sp"
        app:layout_constraintStart_toEndOf="@+id/tvSynthesize"
        android:textColor="@color/color_ffffff"
        android:layout_marginStart="30dp"
        app:layout_constraintTop_toTopOf="@+id/tvSynthesize"
        />


    <TextView
        android:id="@+id/tvModel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="无限制角色"
        android:textSize="14sp"
        app:layout_constraintEnd_toStartOf="@+id/ivUnlimited"
        android:textColor="@color/color_b4a5f9"
        android:layout_marginStart="30dp"
        app:layout_constraintTop_toTopOf="@+id/ivSearch"
        app:layout_constraintBottom_toBottomOf="@+id/ivSearch"
        />

    <ImageView
        android:id="@+id/ivUnlimited"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="16dp"
        app:layout_constraintTop_toTopOf="@+id/tvSynthesize"
        app:layout_constraintBottom_toBottomOf="@+id/tvSynthesize"
        app:layout_constraintEnd_toStartOf="@+id/ivSearch"
        android:src="@mipmap/icon_limited"
        android:paddingStart="10dp"
        android:paddingEnd="10dp"
        android:paddingTop="4dp"
        android:paddingBottom="4dp"  />


    <ImageView
        android:id="@+id/ivSearch"
        android:layout_width="60dp"
        android:layout_height="wrap_content"
        android:layout_marginEnd="16dp"
        app:layout_constraintTop_toTopOf="@+id/tvSynthesize"
        app:layout_constraintBottom_toBottomOf="@+id/tvSynthesize"
        app:layout_constraintEnd_toEndOf="parent"
        android:src="@mipmap/icon_search"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="4dp"
        android:paddingBottom="4dp"
        android:background="@drawable/bg_000000_r50" />

    <!-- 内容区域：使用 ViewPager2 实现切换 -->
    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/viewPager"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:background="@color/color_1c1d20"
        app:tabBackground="@color/color_1c1d20"
        android:layout_marginTop="15dp"
        app:layout_constraintTop_toBottomOf="@+id/tvSynthesize"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>