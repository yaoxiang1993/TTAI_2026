<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent" 
    android:background="@color/color_1c1d20"
    android:paddingTop="10dp">

    <TextView
        android:id="@+id/tvTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:padding="5dp"
        android:text="控制"
        android:textColor="@color/white"
        android:textSize="18sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tvTitle">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <LinearLayout
                android:id="@+id/llyAddArticles"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="15dp"
                android:background="@drawable/bg_383838_r5"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                android:paddingTop="10dp"
                android:paddingBottom="10dp">

                <ImageView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:background="@drawable/bg_454545_r100"
                    android:padding="10dp"
                    android:src="@mipmap/icon_add_articles" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:gravity="center"
                    android:text="添加设备"
                    android:textColor="@color/white"
                    android:textSize="14sp" />
            </LinearLayout>

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/clyEdit"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_constraintTop_toBottomOf="@+id/llyAddArticles"
            app:layout_constraintStart_toStartOf="@+id/llyAddArticles"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_383838_r5"
            android:layout_margin="15dp"
            android:padding="15dp"
            android:visibility="gone"
            tools:visibility="visible"
            >
            <ImageView
                android:id="@+id/ivIcon"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:src="@mipmap/icon_device_defulte"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                android:layout_marginTop="10dp"
                android:layout_marginStart="15dp"
                />
            <TextView
                android:id="@+id/tvName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:layout_constraintStart_toEndOf="@+id/ivIcon"
                app:layout_constraintTop_toTopOf="@+id/ivIcon"
                app:layout_constraintBottom_toBottomOf="@+id/ivIcon"
                android:text="XXXXXX"
                android:textColor="@color/white"
                android:textSize="14sp"
                android:layout_marginStart="5dp"
                />
            <TextView
                android:id="@+id/tvState"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:layout_constraintStart_toEndOf="@+id/tvName"
                app:layout_constraintTop_toTopOf="@+id/ivIcon"
                app:layout_constraintBottom_toBottomOf="@+id/ivIcon"
                android:text="已连接"
                android:textColor="@color/color_929292"
                android:textSize="12sp"
                android:layout_marginStart="5dp"
                />

            <ImageView
                android:id="@+id/tvSelected"
                android:layout_width="70dp"
                android:layout_height="50dp"
                android:src="@mipmap/icon_switch_select"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/ivIcon"
                android:background="@color/color_454545"
                android:layout_marginTop="5dp"
                />

            <TextView
                android:id="@+id/tvEdite"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/tvSelected"
                android:text="编辑"
                android:layout_marginTop="10dp"
                android:textColor="@color/white"
                android:textSize="14sp"
                />

        </androidx.constraintlayout.widget.ConstraintLayout>


            <TextView
                android:id="@+id/tvCollect"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_margin="15dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_383838_r5"
                android:drawableEnd="@mipmap/icon_arrow_right_gray"
                android:gravity="center_vertical"
                android:paddingStart="20dp"
                android:paddingEnd="10dp"
                android:text="收藏模式"
                android:textColor="@color/white"
                android:textSize="14sp"
                app:layout_constraintTop_toBottomOf="@+id/clyEdit"
                tools:layout_editor_absoluteX="15dp" />

            <TextView
                android:id="@+id/tvRemoteControl"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:text="远程互助"
                android:textColor="@color/white"
                android:textSize="14sp"
                app:layout_constraintTop_toBottomOf="@+id/tvCollect"
                android:background="@drawable/bg_383838_r5"
                android:paddingStart="20dp"
                android:paddingEnd="10dp"
                android:gravity="center_vertical"
                android:layout_margin="15dp"
                android:drawableEnd="@mipmap/icon_arrow_right_gray"
                android:visibility="gone"
                tools:visibility="visible"
                />

            <TextView
                android:id="@+id/tvAIControl"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:text="AI控制"
                android:textColor="@color/white"
                android:textSize="14sp"
                app:layout_constraintTop_toBottomOf="@+id/tvRemoteControl"
                android:background="@drawable/bg_383838_r5"
                android:paddingStart="20dp"
                android:paddingEnd="10dp"
                android:gravity="center_vertical"
                android:layout_margin="15dp"
                android:drawableEnd="@mipmap/icon_arrow_right_gray"
                android:visibility="gone"
                tools:visibility="visible"
                />
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/llc1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:layout_constraintTop_toBottomOf="@+id/tvAIControl"
                android:background="@drawable/bg_383838_r5"
                android:paddingTop="20dp"
                android:paddingBottom="20dp"
                android:layout_margin="15dp">
                <TextView
                    android:id="@+id/tvLevel1"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="震动强度"
                    android:textColor="@color/white"
                    android:layout_marginStart="20dp"
                    android:textSize="14sp"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    />

                <SeekBar
                    android:id="@+id/progressSlider1"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:max="100"
                    android:background="@null"
                    android:progress="0"
                    android:progressDrawable="@drawable/seekbar_progress"
                    android:layout_marginStart="15dp"
                    android:layout_marginEnd="15dp"
                    android:layout_marginTop="10dp"
                    android:minHeight="2dp"
                    android:maxHeight="2dp"
                    app:layout_constraintTop_toBottomOf="@+id/tvLevel1"

                    />
            </androidx.constraintlayout.widget.ConstraintLayout>
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/llc2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:layout_constraintTop_toBottomOf="@+id/llc1"
                android:background="@drawable/bg_383838_r5"
                android:orientation="vertical"
                android:paddingTop="20dp"
                android:paddingBottom="20dp"
                android:layout_margin="15dp">
                <TextView
                    android:id="@+id/tvLevel2"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="吮吸强度"
                    android:textColor="@color/white"
                    android:textSize="14sp"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    android:layout_marginStart="20dp"
                    />

                <SeekBar
                    android:id="@+id/progressSlider2"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:max="100"
                    android:progress="0"
                    android:background="@null"
                    android:progressDrawable="@drawable/seekbar_progress"
                    android:minHeight="2dp"
                    android:maxHeight="2dp"
                    android:layout_marginTop="10dp"
                    android:layout_marginStart="15dp"
                    android:layout_marginEnd="15dp"
                    app:layout_constraintTop_toBottomOf="@+id/tvLevel2"
                    />
            </androidx.constraintlayout.widget.ConstraintLayout>

            <androidx.constraintlayout.widget.ConstraintLayout
                app:layout_constraintTop_toBottomOf="@+id/llc2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingTop="20dp"
                android:paddingBottom="20dp"
                android:layout_margin="15dp"
                >

                <TextView
                    android:id="@+id/tvText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="模式（点击心形可收藏）"
                    android:textColor="@color/white"
                    android:textSize="14sp"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    />
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/mRecyclerView"
                    android:layout_width="match_parent"
                    android:layout_height="400dp"
                    android:background="@color/color_1c1d20"
                    android:orientation="vertical"
                    android:layout_marginTop="5dp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/tvText"/>
             </androidx.constraintlayout.widget.ConstraintLayout>


        </androidx.constraintlayout.widget.ConstraintLayout>

    </androidx.core.widget.NestedScrollView>


</androidx.constraintlayout.widget.ConstraintLayout>